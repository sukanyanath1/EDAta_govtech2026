FROM python:3.12-slim

WORKDIR /app

# Install uv (same version used locally)
RUN pip install --no-cache-dir uv==0.8.14

# ── Dependency layer (cache-busted only when pyproject.toml changes) ──────────
COPY pyproject.toml .
RUN uv pip install --system -r pyproject.toml

# ── Application source ────────────────────────────────────────────────────────
COPY app/ ./app/
COPY data/ ./data/

EXPOSE 8000

# Disable reload in production; bind to all interfaces for container networking
CMD ["uvicorn", "app.v1.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
